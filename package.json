{
  "name": "tax-project",
  "private": true,
  "workspaces": [
    "shared",
    "local-ai",
    "server",
    "apps/individual",
    "apps/preparer"
  ],
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:individual": "npm run dev -w @hatax/individual",
    "dev:preparer": "npm run dev -w @hatax/preparer",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:individual\" \"npm run dev:preparer\"",
    "build:individual": "npm run build -w @hatax/individual",
    "build:preparer": "npm run build -w @hatax/preparer",
    "start:individual": "node scripts/start-site.mjs individual",
    "start:preparer": "node scripts/start-site.mjs preparer",
    "build:shared": "npm run build -w shared",
    "test": "npm test -w shared && npm test -w @hatax/local-ai",
    "test:engine": "npm test -w shared",
    "test:local-ai": "npm test -w @hatax/local-ai",
    "gen:constants": "npx tsx scripts/gen-constants-doc.ts"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/d3-sankey": "^0.12.5",
    "@types/jsonwebtoken": "^9.0.10",
    "concurrently": "^9.1.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "d3-sankey": "^0.12.3",
    "jsonwebtoken": "^9.0.3"
  }
}
