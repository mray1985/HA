node_modules/
dist/
.env
.env.local
.env.*.local
*.tsbuildinfo

# OS files
.DS_Store

# SQLite database files
*/server/data/*.db
*/server/data/*.db-shm
*/server/data/*.db-wal
# Per-install token-signing key (created on first start when JWT_SECRET is unset)
*/server/data/jwt-secret

# Claude project files
.claude/

# Test artifacts
*/client/playwright-report/
*/client/test-results/

# Internal audit & review docs
*/client/SECURITY-AUDIT*.md
*/client/UX-REVIEW*.md
*.rtf

# Archive (private files, research, strategy, test data)
Archive/

# Local ML model weights (never commit GGUF / ONNX / safetensors / tokenizers)
models/
*.gguf
*.onnx
*.safetensors

# Local llama.cpp binaries (quantize / cli / server) — bundled by the installer, not committed
preparer/tools/llama-cpp/

# Python bytecode from local-ai/scripts
__pycache__/

# Model gauntlet renders
preparer/local-ai/gauntlet/out/

# Development server data (sign-in database, token key, model verification)
preparer/server/data/

# Scratch: probe scripts, CI logs, PR bodies, debug dumps. Written by hand while
# investigating, and not part of any build.
/tmp/
