# Copy to client/.env.local (not committed) and fill in.

# Syncfusion Essential JS 2 license key, for the version in package.json (32.x).
# Get it at https://www.syncfusion.com/account/claim-license-key, for
# Essential Studio for JavaScript (or React) version 32.x. The free Community
# License covers an organization with under $1M USD annual revenue, 5 or fewer
# developers, 10 or fewer employees, and never more than $3M of outside
# capital (https://www.syncfusion.com/products/communitylicense); otherwise
# a paid license.
# Without it the PDF viewer and charts show Syncfusion's license banner, and
# the installer (desktop: npm run dist) refuses the build.
VITE_SYNCFUSION_LICENSE_KEY=

# Optional BYOK / tip-jar API origin (Express server). Private Mode needs neither.
# Used by chat, AI extraction, merchant classification, and tip links.
# Dev default in code is http://localhost:3001 when unset.
# VITE_API_BASE=http://localhost:3001

# Production builds: optional public API origin injected into CSP connect-src
# (also accepted as VITE_API_ORIGIN by vite.config.ts).
# VITE_API_ORIGIN=https://your-api.example.com
