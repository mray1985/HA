# Copy to client/.env for local overrides (optional for Private Mode).

# Syncfusion Essential JS 2 — Community License Key
# Free for individuals and companies with <$1M revenue and <5 developers.
# Get yours at: https://www.syncfusion.com/account/claim-license-key
# App runs without this; chart components may show a license banner.
VITE_SYNCFUSION_LICENSE_KEY=

# Optional BYOK / tip-jar API origin (Express server). Private Mode needs neither.
# Used by chat, AI extraction, merchant classification, and tip links.
# Dev default in code is http://localhost:3001 when unset.
# VITE_API_BASE=http://localhost:3001

# Production builds: optional public API origin injected into CSP connect-src
# (also accepted as VITE_API_ORIGIN by vite.config.ts).
# VITE_API_ORIGIN=https://your-api.example.com
