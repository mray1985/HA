# HA Tax service / HATax Server — Environment Variables
# Copy this file to server/.env and fill in values as needed.
# The consumer Private Mode app does NOT require this server.

# ─── Server ───────────────────────────────────────
# PORT=3001
# TRUST_PROXY=0
# Comma-separated browser origins allowed by CORS (defaults include Vite 5173/4173)
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# ─── Tip Jar (Stripe Payment Links) ─────────────────────────
# Pre-create Payment Links in Stripe Dashboard, paste URLs here.
# STRIPE_TIP_LINK_SMALL=https://buy.stripe.com/...   # $5
# STRIPE_TIP_LINK_MEDIUM=https://buy.stripe.com/...  # $10
# STRIPE_TIP_LINK_LARGE=https://buy.stripe.com/...   # $25
