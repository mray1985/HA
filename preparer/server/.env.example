# HA Tax Preparer server — environment variables (development)
# Copy this file to server/.env and fill in values as needed. The desktop app
# sets what it needs itself and starts this server on 127.0.0.1.

# ─── Server ───────────────────────────────────────
# PORT=3002
# HOST=0.0.0.0
# TRUST_PROXY=0
# Extra browser origins allowed by CORS (the defaults are the dev client on
# 5174, its preview on 4174, and the server's own port)
# ALLOWED_ORIGINS=http://localhost:5174

# ─── Data ─────────────────────────────────────────
# The sign-in database (default: server/data/hatax.db)
# HATAX_DB_PATH=./data/hatax.db

# ─── Local models ─────────────────────────────────
# llama.cpp's llama-server and the approved model files
# (default: tools/llama-cpp and models/ in preparer/)
# HATAX_LLAMA_SERVER=
# HATAX_MODELS_DIR=
